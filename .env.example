# Server Configuration
PORT=5000
HOST=localhost

# FFmpeg & FFprobe Executable Paths
# If left empty, the application checks PATH, then auto-discovers Kdenlive/winget paths
FFMPEG_PATH=C:\Program Files\Kdenlive\bin\ffmpeg.exe
FFPROBE_PATH=C:\Program Files\Kdenlive\bin\ffprobe.exe

# Storage Path (relative to project root or absolute)
STORAGE_DIR=./storage

# Render Configuration
MAX_CONCURRENT_RENDERS=2
MAX_UPLOAD_SIZE_MB=500
